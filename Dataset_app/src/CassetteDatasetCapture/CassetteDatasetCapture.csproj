<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsTargetPlatformVersion>10.0.22621.0</WindowsTargetPlatformVersion>
    <TargetPlatformVersion>10.0.22621.0</TargetPlatformVersion>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <TargetPlatformSdkRootOverride>C:\Program Files (x86)\Windows Kits\10</TargetPlatformSdkRootOverride>
    <TargetPlatformMoniker>Windows,Version=10.0.22621.0</TargetPlatformMoniker>
    <TargetPlatformDisplayName>Windows 10.0.22621.0</TargetPlatformDisplayName>
    <PlatformTarget>x64</PlatformTarget>
    <LocalAppData>$(MSBuildProjectDirectory)\.appdata</LocalAppData>
    <GalaxySdkDll>$(MSBuildProjectDirectory)\Dependencies\GxIAPINET.dll</GalaxySdkDll>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('C:\Program Files\Daheng Imaging\GalaxySDK\APIDll\Win64\.NET6.0\GxIAPINET.dll')">
    <GalaxySdkDll>C:\Program Files\Daheng Imaging\GalaxySDK\APIDll\Win64\.NET6.0\GxIAPINET.dll</GalaxySdkDll>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(GalaxySdkDll)')">
    <DefineConstants>$(DefineConstants);HAS_GALAXY_SDK</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(GalaxySdkDll)')">
    <Reference Include="GxIAPINET">
      <HintPath>$(GalaxySdkDll)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
